{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "connections": {
          "$connectionId": {
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "guests": {
      "$guestId": {
        ".write": "$guestId.matches(/^guest_[0-9]{10,16}_[a-z0-9]{1,12}$/)",
        ".validate": "newData.hasChildren(['isOnline', 'lastSeen'])",
        "isOnline": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "p2pSignals": {
      "$convId": {
        ".read": "auth != null && $convId.matches(/^[A-Za-z0-9]{6,64}_[A-Za-z0-9]{6,64}$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid))",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && $convId.matches(/^[A-Za-z0-9]{6,64}_[A-Za-z0-9]{6,64}$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid))",
          "$signalId": {
            ".validate": "newData.hasChildren(['from', 'sessionId', 'type', 'ts']) && newData.child('from').val() === $uid && ((newData.child('type').val() === 'hello' && !newData.hasChild('sdp') && !newData.hasChild('candidate')) || (newData.child('type').val() === 'ice' && newData.hasChild('candidate') && !newData.hasChild('sdp')) || ((newData.child('type').val() === 'offer' || newData.child('type').val() === 'answer') && newData.hasChild('sdp') && !newData.hasChild('candidate')))",
            "from": {
              ".validate": "newData.isString()"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._-]{6,64}$/)"
            },
            "type": {
              ".validate": "newData.isString() && (newData.val() === 'hello' || newData.val() === 'offer' || newData.val() === 'answer' || newData.val() === 'ice')"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 10000 && newData.val() >= now - 300000"
            },
            "sdp": {
              ".validate": "newData.hasChildren(['type', 'sdp']) && newData.child('type').val() === newData.parent().child('type').val()",
              "type": {
                ".validate": "newData.isString() && (newData.val() === 'offer' || newData.val() === 'answer')"
              },
              "sdp": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16000"
              },
              "$other": {
                ".validate": false
              }
            },
            "candidate": {
              ".validate": "newData.hasChild('candidate')",
              "candidate": {
                ".validate": "newData.isString() && newData.val().length <= 1024"
              },
              "sdpMid": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "sdpMLineIndex": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64"
              },
              "usernameFragment": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "p2pDeviceSync": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "p2pGroupPresence": {
      "$groupId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "p2pGroupSignals": {
      "$groupId": {
        "$toUid": {
          ".read": "auth != null && auth.uid == $toUid",
          "$fromUid": {
            ".write": "auth != null && auth.uid == $fromUid"
          }
        }
      }
    }
  }
}
