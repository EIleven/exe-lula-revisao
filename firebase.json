
{
  "firestore": [
    {
      "database": "echo-db-124325",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "apphosting": {
    "backendId": "studio",
    "rootDir": "./",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "functions",
      "video-worker",
      "android",
      "e2e",
      "docs",
      "scripts",
      ".emulator-state",
      "*-debug.log",
      ".env*",
      "firebase.emulators.json",
      "-p",
      "out"
    ]
  }
}
